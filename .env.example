# ===========================
# Game Bot
# ===========================
GAME_BOT_TOKEN=your_game_bot_token_here

# ===========================
# Admin Bot
# ===========================
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# ===========================
# PostgreSQL
# ---
# Локальная разработка (docker-compose):
#   DATABASE_URL=postgresql+asyncpg://mafia:mafia_secret@postgres:5432/mafia_db
#
# Railway: НЕ прописывай вручную — Railway сам подставит DATABASE_URL
#   из подключённой PostgreSQL базы. Формат postgresql:// конвертируется
#   автоматически в postgresql+asyncpg:// (см. bot/config.py).
# ===========================
DATABASE_URL=postgresql+asyncpg://mafia:mafia_secret@postgres:5432/mafia_db

# ===========================
# Admin IDs (через запятую)
# ===========================
ADMIN_IDS=123456789,987654321

# ===========================
# Economy
# ===========================
STARTING_COINS=50
WIN_REWARD_COINS=30
DIAMOND_TO_COINS_RATE=100
